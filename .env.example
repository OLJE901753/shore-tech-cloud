# Host user mapping (linuxserver images)
PUID=1000
PGID=1000
TZ=Europe/Oslo

COMPOSE_PROJECT_NAME=sync-server

# DuckDNS (https://www.duckdns.org)
DUCKDNS_SUBDOMAIN=your-subdomain
DUCKDNS_TOKEN=your-duckdns-token
# Full hostname for NPM + tunnel-fallback (default: <subdomain>.duckdns.org)
DUCKDNS_FQDN=your-subdomain.duckdns.org

# Syncthing device label in the web UI
SYNCTHING_HOSTNAME=sync-server

# Optional: create File Browser admin during ./init.sh (stop container briefly)
FILEBROWSER_ADMIN_USER=admin
FILEBROWSER_ADMIN_PASSWORD=

# Optional: Cloudflare named tunnel (profile tunnel-named)
# CLOUDFLARE_TUNNEL_TOKEN=
